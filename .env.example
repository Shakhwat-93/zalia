# ==================================================
# ZALIA PROPERTIES LTD — ENVIRONMENT CONFIGURATION
# ==================================================

# 1. Supabase PostgreSQL (Self-Hosted VPS)
# Required for server-side queries and admin service role mutations
SUPABASE_URL=http://your-vps-supabase-instance:8000
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Public Supabase Client (Browser safe)
NEXT_PUBLIC_SUPABASE_URL=http://your-vps-supabase-instance:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. Zoho Mail SMTP Configuration (Server-Side Only - Never expose to client)
ZOHO_SMTP_HOST=smtppro.zoho.eu
ZOHO_SMTP_PORT=465
ZOHO_SMTP_USER=enquiries@zaliaproperties.com
ZOHO_SMTP_PASSWORD=your-zoho-app-password-here
ZOHO_FROM_EMAIL=enquiries@zaliaproperties.com
ZOHO_TO_EMAIL=directors@zaliaproperties.com
